# TechWise Backend Environment Configuration
PORT=3001
NODE_ENV=development
GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Phase 2 Database Foundation (PostgreSQL + pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/techwise?schema=public
DATABASE_TYPE=in-memory

# AI & Voice Configuration
AI_PROVIDER=local
AI_MODEL_NAME=distilbert-base-uncased-mnli
WHISPER_MODEL=Xenova/whisper-small
